# Copy this file to `.env` (git-ignored) and fill in the keys.

# --- Jev (TypeSafe) ----------------------------------------------------------
# Key from https://typesafe.ai. A `jev.txt` file holding only the key also works.
TYPESAFE_API_KEY=
# Alias or pinned version. jev-latest points to jev-1.13.0 today.
JEV_MODEL=jev-latest

# --- Laya (local) ------------------------------------------------------------
# With Docker the arena uses http://laya:8000 automatically. Native runs:
LAYA_URL=http://localhost:8000
# english | multilingual | typed-decisions
LAYA_CHECKPOINT=typed-decisions

# --- LM Studio (optional third player) ----------------------------------------
LMSTUDIO_URL=http://localhost:1234/v1
LMSTUDIO_API_KEY=
LMSTUDIO_MODEL=
